{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guide",
  "version": "0.1.0",
  "identifier": "com.mikesmedes.guide",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Guide",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/guide-sidecar"],
    "resources": {
      "../prompts/persona.md": "prompts/persona.md",
      "../prompts/skills": "prompts/skills",
      "../sidecar/node_modules/@mariozechner/pi-coding-agent/package.json": "pi-package/package.json"
    }
  }
}
