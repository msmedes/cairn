{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "summary"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "merged",
        "closed_issue",
        "no_open_issues",
        "no_ready_issues",
        "blocked",
        "needs_human",
        "error"
      ]
    },
    "issue_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "pr_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "branch": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
